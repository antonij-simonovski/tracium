# Copy to .env for local development. Never commit the filled-in .env.
#
# ClickHouse over HTTP: only 8123 is exposed on the host (native 9000 is not).
# clickhouse-go selects HTTP from the http:// scheme, not a query param.
CLICKHOUSE_DSN=http://default:changeme@localhost:8123/tracium
POSTGRES_DSN=postgres://tracium:changeme@localhost:5432/tracium?sslmode=disable

# Required — no default on purpose. A secret shared by every install is public,
# and HS256 verifies with the same key it signs with, so anyone holding it can
# mint admin tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Background anomaly checks that open incidents (GET /v1/incidents).
DETECTION_ENABLED=true
DETECTION_INTERVAL_SECONDS=300
DETECTION_MIN_SEVERITY=warning

# Alert channels post to Slack and webhook URLs only over https and only to
# public addresses. Set true to allow http and private, loopback or link-local
# addresses, for an internal service on a self-hosted install.
ALERTS_ALLOW_PRIVATE_URLS=false
