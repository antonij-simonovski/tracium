# Copy to .env before `docker compose up`. Never commit the filled-in .env.

# Release images to run. Add `-f compose.build.yaml` (or `make up`) to build from source.
TRACIUM_VERSION=1.2.3

CLICKHOUSE_PASSWORD=
POSTGRES_PASSWORD=

# Required by the api service — compose refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional. The origin you open the dashboard at, with no path, e.g.
# https://tracium.example.com or http://localhost:3000. Setting it turns on
# OAuth for MCP clients: Claude and others connect to <PUBLIC_URL>/v1/mcp and
# sign in, instead of using a pasted read key. Empty leaves OAuth off. Claude's
# hosted connectors need this URL reachable from the internet.
PUBLIC_URL=

# How many days of spans to keep. 0 = keep forever (no TTL), e.g. for annual reports.
RETENTION_DAYS=90
