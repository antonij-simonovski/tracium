# Copy to .env before `docker compose up`. Never commit the filled-in .env.

# Release images to run. Add `-f compose.build.yaml` (or `make up`) to build from source.
TRACIUM_VERSION=1.2.0

CLICKHOUSE_PASSWORD=
POSTGRES_PASSWORD=

# Required by the api service — compose refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# How many days of spans to keep. 0 = keep forever (no TTL), e.g. for annual reports.
RETENTION_DAYS=90
