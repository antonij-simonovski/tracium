{
  "name": "tracium-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed-account.mjs && node scripts/seed.mjs",
    "seed:account": "node scripts/seed-account.mjs",
    "seed:data": "node scripts/seed.mjs",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-query": "^5.104.0",
    "react-router-dom": "^6.24.1"
  },
  "devDependencies": {
    "vite": "^5.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vitest": "^2.0.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.1.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  },
  "files": [
    "dist-library"
  ],
  "types": "./dist-library/types/index.d.ts",
  "module": "./dist-library/index.js",
  "exports": {
    ".": {
      "types": "./dist-library/types/index.d.ts",
      "import": "./dist-library/index.js"
    },
    "./style.css": "./dist-library/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
